<%
// tsdemo.eta - keep templates thin, put business logic in .ts library files
const { formatUser, sum } = require('./tslib.ts')
const users = [
  { name: 'alice', age: 30 },
  { name: 'bob', age: 25 },
]
%><!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>TypeScript demo</title></head>
<body>
  <h1>TypeScript in eta-server</h1>
  <p>Template code blocks are JS-only, but logic libraries can be .ts —
     this page comes straight from <code>require('./tslib.ts')</code>,
     zero build step.</p>
  <ul>
  <% for (const u of users) { %>
    <li><%= formatUser(u) %></li>
  <% } %>
  </ul>
  <p>sum([1,2,3]) = <%= sum([1, 2, 3]) %></p>
  <p><a href="index.eta">back home</a></p>
</body>
</html>
