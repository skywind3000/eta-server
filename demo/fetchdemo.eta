<%
// fetchdemo.eta - requesting other URLs from a template (top-level await + built-in fetch)
//
// renderAsync compiles the template into an async function body, so code blocks
// can use top-level await; while waiting on the network the event loop keeps
// serving other requests, the single thread never blocks.
//
// This example shows two usages:
//   1. self request: fetch this server's own hello.eta (no external network needed)
//   2. external URL: just swap url for something like
//      'https://api.github.com/users/nodejs/repos', the code is identical
//
// (note: never write literal tag syntax inside comments - the parser is a
// plain-text scanner and would mis-parse them)
const url = 'http://' + _SERVER.SERVER_NAME + ':' + _SERVER.SERVER_PORT +
  '/hello.eta/from-fetchdemo'
let text = null
let error = null
try {
  const ctrl = new AbortController()
  const timer = setTimeout(() => ctrl.abort(), 8000)   // 8 second timeout guard
  const resp = await fetch(url, { signal: ctrl.signal })
  clearTimeout(timer)
  if (!resp.ok) throw new Error('HTTP ' + resp.status)
  text = await resp.text()
} catch (e) {
  error = String(e && e.message || e)
}
%><!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>fetch demo</title></head>
<body>
  <h1>fetch in .eta (top-level await)</h1>
  <% if (error) { %>
    <p style="color:#a00">fetch failed: <%= error %></p>
  <% } else { %>
    <p>Below is the raw hello.eta response obtained via await fetch:</p>
    <pre><%= text %></pre>
  <% } %>
  <p><a href="index.eta">back home</a></p>
</body>
</html>
